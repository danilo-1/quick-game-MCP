{
  "name": "quick-game-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP especializado em criação de jogos: guia todas as etapas, do conceito ao lançamento, e abstrai a camada técnica.",
  "type": "module",
  "bin": {
    "quick-game-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills",
    "templates",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilo-1/quick-game-MCP.git"
  }
}
